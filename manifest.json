{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.1.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "minimum_chrome_version": "150",
  "homepage_url": "https://github.com/ursasi/tabclip",
  "permissions": ["tabs", "contextMenus", "clipboardWrite", "offscreen"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "__MSG_actionTitle__" },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "commands": {
    "copy-selected-urls": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "__MSG_commandCopySelected__"
    }
  }
}
